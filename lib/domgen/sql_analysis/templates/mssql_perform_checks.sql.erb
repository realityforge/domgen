AS
  SET NOCOUNT ON

  DECLARE @StoredProfile VARCHAR(100)
  IF (SELECT COUNT(*) FROM <%= profile_entity.sql.qualified_table_name %>) <> 1
    THROW 51000, 'The database must contain exactly one Test Profile identity', 1
