# DO NOT EDIT: File is auto-generated
---
modules: !omap
<% repository.data_modules.select{|data_module| data_module.sql?}.each do |data_module| -%>
   - <%= data_module.sql.schema %>:
      schema: <%= data_module.sql.schema %>
<% tables = data_module.entities.select { |entity| entity.sql? && entity.concrete? } -%>
      tables:<%= tables.empty? ? ' []' : '' %>
<% tables.each do |entity| -%>
         - name: "<%= entity.sql.qualified_table_name.gsub('"',"\\\"") %>"
           columns:
<% entity.attributes.select(&:sql?).each do |attribute| -%>
             - "<%= attribute.sql.quoted_column_name.gsub('"',"\\\"") %>"
<% end -%>
           indexes:
             - "<%= entity.sql.dialect.quote("PK_#{entity.name}").gsub('"',"\\\"") %>"
<% entity.sql.indexes.each do |index| -%>
             - "<%= index.quoted_index_name.gsub('"',"\\\"") %>"
<% end -%>
<% if :deployment == entity.sql.row_source -%>
           rowSource: deployment
<% end -%>
<% end -%>
<% sequences = data_module.sql.sequences.collect { |sequence| sequence.qualified_sequence_name } -%>
      sequences:<%= sequences.empty? ? ' []' : '' %>
<% sequences.each do |sequence| -%>
         - "<%= sequence.gsub('"',"\\\"") %>"
<% end -%>
<% end -%>
