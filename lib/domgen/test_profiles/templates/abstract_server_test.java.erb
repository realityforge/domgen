    {
      org.junit.jupiter.api.Assertions.assertEquals( iris.rose.server.plans.HashUtil.recalculateHash( position ),
                                                    position.getHash(),
                                                    "ShiftPosition has not recalculated hash correctly: " + position );
      unitsToProcess.add( position.getUnit() );
    }
    while ( !unitsToProcess.isEmpty() )
    {
      final var unit = unitsToProcess.iterator().next();
      unitsToProcess.remove( unit );
      unitsProcessed.add( unit );
      org.junit.jupiter.api.Assertions.assertEquals( iris.rose.server.plans.HashUtil.recalculateHash( unit ),
                                                    unit.getHash(),
                                                    "ShiftUnit has not recalculated hash correctly: " + unit );
      final var parentComposition = unit.getParentComposition();
      if ( null != parentComposition && !unitsProcessed.contains( parentComposition.getParent() ) )
      {
        unitsToProcess.add( parentComposition.getParent() );
      }
    }
  }

