  @javax.annotation.Nonnull
  protected abstract String getTestProfileName();

  @javax.annotation.Nonnull
  protected abstract com.google.inject.Module newProfileModule();

  protected void addModules( @javax.annotation.Nonnull final java.util.ArrayList<com.google.inject.Module> modules )
  {
  }

  @java.lang.Override
  protected com.google.inject.Module[] getModules()
  {
    final var modules = new java.util.ArrayList<com.google.inject.Module>();
    java.util.Collections.addAll( modules, super.getModules() );
    modules.add( newProfileModule() );
    addModules( modules );
    return modules.toArray( new com.google.inject.Module[ 0 ] );
  }
