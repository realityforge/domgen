  protected final void assertZeroNotifications()
  {
    org.junit.jupiter.api.Assertions.assertEquals( 0, n.findAllNotifications().size() );
  }

  @javax.annotation.Nonnull
  protected final iris.rose.server.notification.Notification ensureNotification( final int index, final int notificationCount )
  {
    final var notifications = n.findAllNotifications()
      .stream()
      .sorted( java.util.Comparator.comparing( iris.rose.server.notification.Notification::getId ) )
      .toList();
    org.junit.jupiter.api.Assertions.assertEquals( notificationCount, notifications.size() );
    return notifications.get( index );
  }

  protected final void assertErrorNotification( @javax.annotation.Nonnull final iris.rose.server.notification.Notification notification,
                                                @javax.annotation.Nonnull final String serviceName )
  {
    org.junit.jupiter.api.Assertions.assertEquals( serviceName + " Error", notification.getTitle() );
    org.junit.jupiter.api.Assertions.assertTrue( notification.hasTag( "error" ) );
    org.junit.jupiter.api.Assertions.assertTrue( notification.hasTag( "service=" + serviceName ) );
  }

  protected void assertErrorNotification( final int index,
                                          final int notificationCount,
                                          @javax.annotation.Nonnull final String serviceName,
                                          @javax.annotation.Nonnull final String groups,
                                          @javax.annotation.Nonnull final String message )
  {
    final var notification = ensureNotification( index, notificationCount );
    assertErrorNotification( notification, serviceName );
    org.junit.jupiter.api.Assertions.assertEquals( message, notification.getMessage() );
    assertGroups( notification, groups );
  }

  protected void assertErrorNotificationContains( final int index,
                                                  final int notificationCount,
                                                  @javax.annotation.Nonnull final String serviceName,
                                                  @javax.annotation.Nonnull final String groups,
                                                  @javax.annotation.Nonnull final String... parts )
  {
    final var notification = ensureNotification( index, notificationCount );
    assertErrorNotification( notification, serviceName );
    final var message = notification.getMessage();
    for ( final var part : parts )
    {
      org.junit.jupiter.api.Assertions.assertTrue( message.contains( part ),
                                                   "Expected message to contain '" + part + "' but message was:\n" + message );
    }
    assertGroups( notification, groups );
  }

  protected void assertErrorNotification( final int index,
                                          final int notificationCount,
                                          @javax.annotation.Nonnull final iris.rose.server.core.Event event,
                                          @javax.annotation.Nonnull final String serviceName,
                                          @javax.annotation.Nonnull final String message )
  {
    final var notification = ensureNotification( index, notificationCount );
    assertErrorNotification( notification, serviceName );
    org.junit.jupiter.api.Assertions.assertEquals( message, notification.getMessage() );
    assertGroups( notification, event.getNotificationGroupCode() );
  }

  protected final void assertSuccessNotification( @javax.annotation.Nonnull final iris.rose.server.notification.Notification notification,
                                                  @javax.annotation.Nonnull final String serviceName )
  {
    org.junit.jupiter.api.Assertions.assertEquals( serviceName + " Success", notification.getTitle() );
    org.junit.jupiter.api.Assertions.assertFalse( notification.hasTag( "error" ) );
    org.junit.jupiter.api.Assertions.assertTrue( notification.hasTag( "service=" + serviceName ) );
  }

  protected void assertSuccessNotification( final int index,
                                            final int notificationCount,
                                            @javax.annotation.Nonnull final iris.rose.server.core.Event event,
                                            @javax.annotation.Nonnull final String serviceName,
                                            @javax.annotation.Nonnull final String expected )
  {
    final var notification = ensureNotification( index, notificationCount );
    assertSuccessNotification( notification, serviceName );
    org.junit.jupiter.api.Assertions.assertEquals( expected, notification.getMessage() );
    assertGroups( notification, event.getNotificationGroupCode() );
  }

  protected final void assertGroups( @javax.annotation.Nonnull final iris.rose.server.notification.Notification notification,
                                     @javax.annotation.Nonnull final String groups )
  {
    org.junit.jupiter.api.Assertions.assertEquals( groups,
                                                   notification.getGroupRecipients()
                                                     .stream()
                                                     .map( recipient -> java.util.Objects.requireNonNull( recipient.getGroup().getCode() ) )
                                                     .sorted()
                                                     .collect( java.util.stream.Collectors.joining( "|" ) ) );
  }

