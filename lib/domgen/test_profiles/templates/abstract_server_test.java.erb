                                                      @javax.annotation.Nonnull final iris.rose.server.core.ResourceGroup... expected )
  {
    org.junit.jupiter.api.Assertions.assertEquals( expected.length, result.getCount() );
    for ( final var unit : expected )
    {
      var found = false;
      for ( final var entry : result.getResults() )
      {
        if ( unit.getId() == entry.getId() )
        {
          org.junit.jupiter.api.Assertions.assertEquals( unit.getName(), entry.getName() );
          found = true;
          break;
        }
      }
      org.junit.jupiter.api.Assertions.assertTrue( found, "Expected to have found unit " + unit );
    }
  }

