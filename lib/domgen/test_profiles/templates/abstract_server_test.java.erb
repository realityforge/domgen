  protected final void assertShiftHashesUpToDate()
  {
    final java.util.Set<iris.rose.server.plans.ShiftUnit> unitsToProcess = new java.util.HashSet<>();
    final java.util.Set<iris.rose.server.plans.ShiftUnit> unitsProcessed = new java.util.HashSet<>();
