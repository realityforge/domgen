    any_dataset_links_that_require_source_filter_parameter = !entity.attributes.select{|a| a.replicant?}.collect{|attribute| attribute.replicant.automatic_dataset_links }.flatten.select{|dataset_link| dataset_link.target_filter_parameter_requires_source_filter_parameter?}.empty?

    root_id_ref = is_instance ? "#{dataset_root_entity_type.jpa.qualified_name}.#{Domgen::Naming.uppercase_constantize(dataset_root_entity_type.primary_key.name)}_COLUMN_NAME" :
                  dataset_root_entity_type_reference ? "#{dataset_root_entity_type_reference.entity.jpa.qualified_name}.#{Domgen::Naming.uppercase_constantize(dataset_root_entity_type_reference.name)}_COLUMN_NAME" :
