  dataset.included_entity_types.collect{|name| repository.entity_by_name(name)}.each do |entity|
    id_key = entity.name.to_s.gsub(/[a-z]/, '')
    is_instance = dataset_root_entity_type == entity
    entity_ever_in_keyed_dataset = entity.replicant.datasets.any?{|dataset| dataset.keyed?}

    dataset_links_to_other_entities = false
    entity.attributes.filter{|attribute| attribute.replicant?}.each do |attribute|
      attribute.replicant.automatic_dataset_links.each do |dataset_link|
        source_dataset = repository.replicant.dataset_by_name(dataset_link.source_dataset)
        target_dataset = repository.replicant.dataset_by_name(dataset_link.target_dataset)
        if source_dataset == dataset
          if target_dataset.instance_dataset? && target_dataset.dataset_root_entity_type != dataset.dataset_root_entity_type && !dataset_link.path.nil?
            if 'EventShiftsInTimePeriod' == dataset.name.to_s
              $stderr.puts( "#{dataset.name} Dataset Links from #{attribute.name} target_root #{target_dataset.dataset_root_entity_type} dataset_root_entity_type=#{dataset.dataset_root_entity_type} #{dataset_link.path.inspect}")
            end
            dataset_links_to_other_entities = true
          end
        end
      end
    end
    # Set to an attribute that references the Dataset Root Entity Type. This is the best available derivation of the
    # Dataset Root identifier, but it may not always work.
    dataset_root_entity_type_references =
      entity.attributes.select{|attribute| attribute.replicant? && attribute.reference? && attribute.referenced_entity == dataset_root_entity_type}
    dataset_root_entity_type_reference = dataset_root_entity_type_references.size == 1 ? dataset_root_entity_type_references[0] : nil;
    root_id_column = is_instance ? entity.primary_key.name : dataset_root_entity_type_reference ? "#{dataset_root_entity_type_reference.sql.column_name}" : "?#{dataset_root_entity_type.name}#{dataset_root_entity_type.primary_key.sql.column_name}"
    require_root_id_column = !is_instance && dataset_root_entity_type_reference.nil?
    add_default_impl =
       dataset.unfiltered? &&
       (is_instance || !dataset_root_entity_type_reference.nil?) &&
