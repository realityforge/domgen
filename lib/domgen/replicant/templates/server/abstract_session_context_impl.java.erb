  @javax.annotation.Nonnull
  private java.util.Map<javax.json.JsonObject, java.util.List<replicant.server.DatasetAddress>> partitionDatasetAddressesByFilterParameter( @javax.annotation.Nonnull final replicant.server.transport.ReplicantSession session, @javax.annotation.Nonnull final java.util.Set<replicant.server.DatasetAddress> targetDatasetAddresses )
