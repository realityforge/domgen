  @java.lang.SuppressWarnings( { "resource", "unused", "SqlSourceToSinkFlow", "SameParameterValue" } )
  void addDatasetAddressInvalidationsForDatasetRootIn<%= dataset.name %>InstanceDataset( @javax.annotation.Nonnull final replicant.server.ChangeSet changeSet, @javax.annotation.Nonnull final java.util.List<replicant.server.DatasetAddress> datasetAddresses )
    throws java.sql.SQLException
  {
    @org.intellij.lang.annotations.Language( "TSQL" )
    final var sql =
      generateTempIdTable( datasetAddresses ) +
      "SELECT Inputs.Id\n" +
      "FROM @Ids Inputs\n" +
      "LEFT JOIN <%= repository.entity_by_name(dataset.dataset_root_entity_type).sql.qualified_table_name %> E ON E.<%= repository.entity_by_name(dataset.dataset_root_entity_type).primary_key.sql.quoted_column_name %> = Inputs.Id\n" +
      "WHERE E.Id IS NULL\n";
    try ( var statement = connection().createStatement( ) )
    {
      try ( var resultSet = statement.executeQuery( sql ) )
      {
        while ( resultSet.next() )
        {
          final var datasetRootId = resultSet.getInt( "Id" );
          final var datasetAddress = replicant.server.DatasetAddress.of( <%= repository.replicant.qualified_dataset_constants_name %>.<%= Domgen::Naming.uppercase_constantize(dataset.name) %>, datasetRootId );
          changeSet.mergeSubscriptionChange( datasetAddress, replicant.server.SubscriptionChange.Type.INVALIDATE_DATASET_ADDRESS );
          final var removed = datasetAddresses.remove( datasetAddress );
          assert removed;
        }
      }
    }
  }
